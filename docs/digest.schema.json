{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Neurotech Hub Daily digest.json","type":"object",
 "required":["schema_version","generated_at","timezone","edition_date","visibility","feedback","nav","sections","in_progress"],
 "properties":{
  "schema_version":{"const":"1.0"},
  "generated_at":{"type":"string","format":"date-time"},
  "timezone":{"const":"America/Chicago"},
  "edition_date":{"type":"string","format":"date"},
  "visibility":{"enum":["internal","public"]},
  "site":{"type":"object"},
  "feedback":{"type":"object","required":["mode","instructions"],"properties":{"mode":{"const":"read_only"},"instructions":{"type":"string"}}},
  "nav":{"type":"array","items":{"type":"object","required":["key","title","count"]}},
  "sections":{"type":"array","items":{"$ref":"#/$defs/section"}},
  "in_progress":{"type":"array","items":{"type":"object","required":["disposition","count","items"],
    "properties":{"disposition":{"enum":["Pursue","Investigate","Monitor"]},"count":{"type":"integer"},"items":{"type":"array","items":{"$ref":"#/$defs/item"}}}}},
  "build_warnings":{"type":"array","items":{"type":"object","required":["code"]}}
 },
 "$defs":{
  "section":{"type":"object","required":["key","title","source","last_refreshed","last_run_status","new_items_count","no_new_items","visible_count","unavailable","unavailable_message","items"],
   "properties":{"key":{"type":"string"},"title":{"type":"string"},"source":{"type":"string"},"cadence":{"type":["string","null"]},
    "last_refreshed":{"type":["string","null"],"format":"date-time"},"last_run_status":{"enum":["ok","partial","error","not_logged"]},
    "last_run_note":{"type":["string","null"]},"next_run":{"type":["string","null"]},"rows_added_last_run":{"type":["integer","null"]},
    "new_items_count":{"type":"integer"},"no_new_items":{"type":"boolean"},"visible_count":{"type":"integer"},
    "unavailable":{"type":"boolean"},"unavailable_message":{"type":["string","null"]},"items":{"type":"array","items":{"$ref":"#/$defs/item"}}}},
  "person":{"type":"object","required":["name"],"properties":{"name":{"type":"string"},"institution":{"type":["string","null"]},"atlas_id":{"type":["string","null"],"pattern":"^ATL-\\d{6}$"},"role_note":{"type":["string","null"]}},"not":{"required":["email"]}},
  "item":{"type":"object",
   "required":["source","item_id","visibility","title","summary","category","subcategory","date_published","date_discovered","date_updated","is_new","link","secondary_links","confidence","score","score_original","disposition","matt_feedback","next_review_date","atlas_ids","related_items","product_matches","people","details","source_record","feedback_instructions"],
   "properties":{
    "source":{"enum":["news","opportunity","funding","innovation","acorn"]},
    "item_id":{"type":"string","pattern":"^[a-z_]+:.+$"},
    "visibility":{"enum":["internal","public"]},
    "title":{"type":"string"},"summary":{"type":["string","null"]},
    "category":{"type":["string","null"]},"subcategory":{"type":["string","null"]},
    "date_published":{"type":["string","null"]},"date_discovered":{"type":["string","null"]},"date_updated":{"type":["string","null"]},
    "is_new":{"type":"boolean"},
    "link":{"type":["string","null"]},"secondary_links":{"type":"array","items":{"type":"string"}},
    "confidence":{"enum":["low","low-medium","medium-low","medium","medium-high","high",null]},
    "score":{"type":["integer","null"],"minimum":0,"maximum":100},
    "score_original":{"type":["object","null"]},
    "disposition":{"enum":["New","Pursue","Investigate","Monitor"]},
    "matt_feedback":{"type":["string","null"]},"next_review_date":{"type":["string","null"],"format":"date"},
    "atlas_ids":{"type":"array","items":{"type":"string","pattern":"^ATL-\\d{6}$"}},
    "related_items":{"type":"array","items":{"type":"object","required":["item_id","via"]}},
    "product_matches":{"type":"array","items":{"type":"object","required":["product_id","name"],"properties":{"product_id":{"type":"string"},"name":{"type":"string"},"store_url":{"type":["string","null"]},"github_url":{"type":["string","null"]}}}},
    "people":{"type":"array","items":{"$ref":"#/$defs/person"}},
    "details":{"type":"object"},
    "source_record":{"type":"object","required":["sheet_url","tab","row","record_id"]},
    "feedback_instructions":{"type":"string"}}}
 }
}
