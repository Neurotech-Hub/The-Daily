---
import { formatEditionDate, httpUrl, synchronizationTime } from '../lib/format.ts';
import type { Digest } from '../lib/types.ts';

interface Props {
  digest: Digest;
  archiveDates: string[];
  archived?: boolean;
}

const { digest, archiveDates, archived = false } = Astro.props;
const title = digest.site?.title?.trim() || 'Neurotech Hub Daily';
const tagline = digest.site?.tagline?.trim() || 'Research, technology, and opportunity intelligence.';
const edition = formatEditionDate(digest.edition_date);
const synced = synchronizationTime(digest.sections, digest.generated_at);
const hubUrl = httpUrl(digest.site?.hub_url);
const home = import.meta.env.BASE_URL;
const archiveHref = `${home}archive/`;
---

<header class="masthead">
  <div class="masthead-brand">
    <h1 class="nameplate">{title}</h1>
    <p class="tagline">{tagline}</p>
  </div>
  <div class="masthead-aside">
    <div class="masthead-meta">
      {edition && <p class="edition-line">{edition}</p>}
      {synced && <p class="sync-line">Synced {synced}</p>}
      {archived && (
        <p class="archive-banner">
          Archived edition.
          <a href={home}>Current edition</a>
        </p>
      )}
    </div>
    {(hubUrl || archiveDates.length > 0) && (
      <nav class="masthead-links" aria-label="Site">
        {archiveDates.length > 0 && <a href={archiveHref}>Archive</a>}
        {hubUrl && (
          <a href={hubUrl} rel="noopener noreferrer" target="_blank">
            Neurotech Hub
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
      </nav>
    )}
  </div>
</header>
