---
import { deliveredItems } from '../lib/format.ts';
import type { Digest } from '../lib/types.ts';
import Story from './Story.astro';

interface Props {
  digest: Digest;
}

const { digest } = Astro.props;
const title = digest.nav.find((entry) => entry.key === 'in_progress')?.title || 'In Progress';
const titles = new Map(digest.sections.map((section) => [section.key, section.title]));
---

<section class="in-progress" id="in_progress" aria-labelledby="heading-in-progress">
  <h2 id="heading-in-progress">{title}</h2>
  {
    digest.in_progress.map((group) => {
      const items = deliveredItems(group.items);
      return (
        <div class="group-block">
          <p class="group-label">
            {group.disposition} ({group.count})
          </p>
          {items.length === 0 && <p class="empty">None.</p>}
          {items.map((item) => (
            <Story
              item={item}
              sectionKey={item.source}
              sectionTitle={titles.get(item.source) || item.source}
              inProgress
            />
          ))}
        </div>
      );
    })
  }
</section>
