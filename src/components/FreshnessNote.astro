---
import { formatSyncTime } from '../lib/format.ts';
import type { Section } from '../lib/types.ts';

interface Props {
  section: Section;
}

const { section } = Astro.props;
const refreshed = formatSyncTime(section.last_refreshed);
const problem = section.unavailable
  ? section.unavailable_message?.trim() || 'This source is unavailable.'
  : section.last_run_status === 'error'
    ? 'Last run failed.'
    : section.last_run_status === 'partial'
      ? 'Last run was partial.'
      : !refreshed && section.last_run_status === 'not_logged'
        ? 'No run recorded'
        : null;
---

<div class="freshness">
  {refreshed && <p>Refreshed {refreshed}</p>}
  {problem && <p class="notice">{problem}</p>}
</div>
