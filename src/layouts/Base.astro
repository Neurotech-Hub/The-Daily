---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <slot />
    <script>
      function detailsButton(panel: HTMLElement): HTMLButtonElement | null {
        const button = document.querySelector(`[aria-controls="${CSS.escape(panel.id)}"]`);
        return button instanceof HTMLButtonElement ? button : null;
      }

      function placeDetails(panel: HTMLElement) {
        const button = detailsButton(panel);
        const wide = window.matchMedia('(min-width: 681px)').matches;
        if (!wide || !button) {
          panel.style.top = '';
          panel.style.left = '';
          panel.style.width = '';
          panel.style.maxHeight = '';
          return;
        }

        const margin = 12;
        const width = Math.min(448, window.innerWidth - margin * 2);
        panel.style.width = `${width}px`;
        const rect = button.getBoundingClientRect();
        const spaceBelow = window.innerHeight - rect.bottom - margin - 8;
        const spaceAbove = rect.top - margin - 8;
        const openBelow = spaceBelow >= 200 || spaceBelow >= spaceAbove;
        panel.style.maxHeight = `${Math.max(160, Math.min(openBelow ? spaceBelow : spaceAbove, 560))}px`;

        const height = panel.getBoundingClientRect().height;
        let left = rect.left;
        if (left + width > window.innerWidth - margin) left = window.innerWidth - margin - width;
        left = Math.max(margin, left);
        const top = openBelow ? rect.bottom + 8 : Math.max(margin, rect.top - 8 - height);
        panel.style.left = `${Math.round(left)}px`;
        panel.style.top = `${Math.round(top)}px`;
      }

      function syncDetails(panel: HTMLElement, open: boolean) {
        const button = detailsButton(panel);
        if (!button) return;
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        button.textContent = open ? 'Hide details' : 'Details';
        if (open) placeDetails(panel);
      }

      function repositionOpenDetails() {
        const wide = window.matchMedia('(min-width: 681px)').matches;
        for (const panel of document.querySelectorAll<HTMLElement>('.story-details')) {
          if (!panel.matches(':popover-open')) continue;
          if (!wide) {
            placeDetails(panel);
            continue;
          }
          const button = detailsButton(panel);
          const rect = button?.getBoundingClientRect();
          if (!rect || rect.bottom < 0 || rect.top > window.innerHeight) {
            panel.hidePopover?.();
            continue;
          }
          placeDetails(panel);
        }
      }

      async function copyText(value: string) {
        try {
          await navigator.clipboard.writeText(value);
          return true;
        } catch {
          const area = document.createElement('textarea');
          area.value = value;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.left = '-9999px';
          document.body.appendChild(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          return ok;
        }
      }

      for (const panel of document.querySelectorAll<HTMLElement>('.story-details')) {
        panel.addEventListener('toggle', (event) => {
          const open = event instanceof ToggleEvent && event.newState === 'open';
          syncDetails(panel, open);
        });
      }

      let repositionFrame = 0;
      document.addEventListener('pointerdown', (event) => {
        if (!(event.target instanceof Node)) return;
        for (const panel of document.querySelectorAll<HTMLElement>('.story-details:popover-open')) {
          const button = detailsButton(panel);
          if (button?.contains(event.target)) continue;
          if (event.target !== panel && panel.contains(event.target)) continue;
          if (event.target === panel && 'clientX' in event) {
            const rect = panel.getBoundingClientRect();
            const point = event as PointerEvent;
            const inside =
              point.clientX >= rect.left &&
              point.clientX <= rect.right &&
              point.clientY >= rect.top &&
              point.clientY <= rect.bottom;
            if (inside) continue;
          }
          panel.hidePopover?.();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const panel of document.querySelectorAll<HTMLElement>('.story-details:popover-open')) {
          panel.hidePopover?.();
        }
      });

      window.addEventListener('resize', () => {
        cancelAnimationFrame(repositionFrame);
        repositionFrame = requestAnimationFrame(repositionOpenDetails);
      });
      window.addEventListener(
        'scroll',
        (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('.story-details')) return;
          cancelAnimationFrame(repositionFrame);
          repositionFrame = requestAnimationFrame(repositionOpenDetails);
        },
        true,
      );

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const jump = target.closest('.story-details a[href^="#"]');
        if (jump instanceof HTMLAnchorElement) {
          const panel = jump.closest('.story-details');
          if (panel instanceof HTMLElement) panel.hidePopover?.();
        }

        const copy = target.closest('[data-copy]');
        if (!(copy instanceof HTMLButtonElement)) return;
        const value = copy.getAttribute('data-copy') ?? '';
        const original = 'Copy';
        void copyText(value).then((ok) => {
          copy.textContent = ok ? 'Copied' : 'Copy failed';
          copy.dataset.state = ok ? 'copied' : 'failed';
          window.setTimeout(() => {
            copy.textContent = original;
          }, 1200);
        });
      });
    </script>
  </body>
</html>
